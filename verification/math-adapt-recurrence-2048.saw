// The controller also checks that this predicate is textually identical to
// the one proved by recurrence-2048.saw, whose successful report is required.
import "Ntt2048.cry";
let n = 2048;
let q = 12289;
include "lemmas.saw";
include "math-tactics.saw";
include "math-components.saw";
let legacy_recurrence_statement = math_formula
  {{ \(a : Poly) (b : Poly) ->
    interleave (addN (convN (evens a) (evens b))
                    (rotate (convN (odds a) (odds b))))
               (addN (convN (evens a) (odds b))
                     (convN (odds a) (evens b))) == convN a b }};
legacy_recurrence_prop <- native_proposition 2 n legacy_recurrence_statement;
check_convertible legacy_recurrence_prop (nth component_props 4);
write_core (str_concat (get_env "NTT_MATH_OUTPUT") "/recurrence.core") legacy_recurrence_prop;
print "Matched exported recurrence to the previously proved predicate";
