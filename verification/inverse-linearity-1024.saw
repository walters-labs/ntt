// Check inverse additivity for the half-size transforms used by the
// 1024-point convolution theorem. No Rust MIR is loaded.
import "Ntt1024.cry";
let n = 1024;
let q = 12289;
include "lemmas.saw";
include "math-tactics.saw";
let half_degree = eval_int {{ `n / 2 : [64] }};
let inverse_root_n = eval_int {{ parameters.inverseRoot }};
let inverse_degree_n = eval_int {{ parameters.inverseLength }};
let inverse_root_h = eval_int {{ repr (`inverse_root_n * `inverse_root_n) }};
let inverse_degree_h = eval_int {{ repr (`inverse_degree_n * 2) }};
print "Checking inverse linearity on 512-element arrays with 64-output chunks";
inverse_linearity_verified <- prove_vector 64 half_degree 2 (math_formula
  {{ \(a : [half_degree]Coeff) (b : [half_degree]Coeff) ->
    idftN `inverse_root_h `inverse_degree_h (addN a b) ==
      addN (idftN `inverse_root_h `inverse_degree_h a)
           (idftN `inverse_root_h `inverse_degree_h b) }});
print "Verified inverse linearity for the 1024-point convolution proof";
