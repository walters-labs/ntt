// Requires m, n, butterfly_overrides, and the proved arithmetic simplifications.
// Large fixed instances need more time per MIR contract. Failure or timeout
// still stops the run; this changes only the resource allowance.
let transform_timeout = if eval_bool {{ `n >= (2048 : [64]) }} then 1800000 else 600000;
include "stage-algebra.saw";
// Butterfly contracts give exact formulas. Derive their bounds from the proved
// repr_range rule after expanding the array combinators.
let stage_solver_proof = do {
  unfolding ["forwardStage", "inverseStage", "forwardTwiddles", "inverseTwiddles",
             "indices", "canonical", "modulus", "modulusInteger", "size"];
  goal_eval_unint ["value", "repr"];
  simplify (addsimps [repr_range, normalize_range] (cryptol_ss ()));
  w4_unint_z3 ["value", "repr"];
};
let steps = map eval_int (eval_list (term_eval {{ [fromInteger x : [64] | x <- stageSteps] }}));
let half_n = eval_int {{ `n / 2 : [64] }};
let stage_spec inverse_direction step = do {
  let stage_step = step;
  a <- mir_fresh_var "a" (mir_array n mir_i64);
  a_ref <- mir_alloc_mut (mir_array n mir_i64);
  twiddles_ref <- mir_alloc (mir_array half_n mir_i64);
  let twiddles = if inverse_direction then {{ inverseTwiddles }} else {{ forwardTwiddles }};
  let result = if inverse_direction then {{ inverseStage `stage_step a }} else {{ forwardStage `stage_step a }};
  mir_points_to a_ref (mir_term a);
  mir_points_to twiddles_ref (mir_term twiddles);
  mir_precond {{ canonical a }};
  mir_execute_func [mir_slice_value a_ref, mir_slice_value twiddles_ref,
                    mir_term {{ `stage_step : [64] }}, mir_term {{ modulus }}];
  mir_points_to a_ref (mir_term result);
  mir_postcond {{ canonical result }};
};
include "stage-bounds.saw";
forward_stages <- for steps (\step -> do {
  bounds <- stage_bounds false step;
  proof <- timeout transform_timeout (mir_verify m "ntt::prepared::forward_stage"
    butterfly_overrides false (stage_spec false step) (stage_proof bounds));
  print (str_concat "Verified forward stage, step " (show step));
  return proof;
});
inverse_stages <- for steps (\step -> do {
  bounds <- stage_bounds true step;
  proof <- timeout transform_timeout (mir_verify m "ntt::prepared::inverse_stage"
    butterfly_overrides false (stage_spec true step) (stage_proof bounds));
  print (str_concat "Verified inverse stage, step " (show step));
  return proof;
});
