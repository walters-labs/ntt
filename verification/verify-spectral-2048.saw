// The squared-modulus case uses the same contracts and tactics as the standard
// split driver. Allow one hour for whole-model/kernel/public checks; individual
// stage contracts retain the standard thirty-minute bound.
let n = eval_int {{ fromInteger size : [64] }};
let q = eval_int {{ modulus }};
let suffix = str_concat (show n) (str_concat "_" (show q));
let entry operation = str_concat "ntt::verification::" (str_concat operation suffix);
m <- mir_load_module mir_path;
include "arithmetic.saw";
include "lemmas.saw";
let arithmetic_overrides = [normalize_verified, add_verified, sub_verified, mul_verified];
include "butterflies.saw";
include "stages.saw";
let transform_timeout = 3600000;
include "models.saw";
include "kernels.saw";
include "multiplication-spec.saw";
let math_formula t = rewrite (cryptol_ss ()) t;
include "compose-spectral.saw";
