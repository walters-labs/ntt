let cyclic_spec = do {
  a <- mir_fresh_var "a" (mir_array n mir_i64);
  b <- mir_fresh_var "b" (mir_array n mir_i64);
  ar <- mir_alloc (mir_array n mir_i64);
  br <- mir_alloc (mir_array n mir_i64);
  mir_points_to ar (mir_term a);
  mir_points_to br (mir_term b);
  mir_execute_func [mir_slice_value ar, mir_slice_value br,
                    mir_term {{ `n:[64] }}, mir_term {{ modulus }}, mir_term {{ parameters.root }}];
  result <- mir_vec_of "result" mir_i64 (mir_term {{ staged_product (normalizePoly a) (normalizePoly b) }});
  mir_return result;
  mir_postcond {{ canonical (staged_product (normalizePoly a) (normalizePoly b)) }};
};
cyclic_verified <- mir_unsafe_assume_spec m "ntt::polymul_ntt" cyclic_spec;
