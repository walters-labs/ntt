enable_experimental;
let d = 8;
m <- mir_load_module (get_opt 1);
let poly_adt = mir_find_adt m "polynomial_ring::Polynomial" [mir_i64];
let allocator = mir_find_adt m "alloc::alloc::Global" [];
let vec_adt = mir_find_adt m "alloc::vec::Vec" [mir_i64, mir_adt allocator];
let raw_vec_adt = mir_find_adt m "alloc::raw_vec::RawVec" [mir_i64, mir_adt allocator];
let typed_allocator_adt = mir_find_adt m "crucible::alloc::TypedAllocator" [mir_i64];
let inner_adt = mir_find_adt m "alloc::raw_vec::RawVecInner" [mir_adt typed_allocator_adt];
let unique_adt = mir_find_adt m "core::ptr::unique::Unique" [mir_u8];
let nonnull_adt = mir_find_adt m "core::ptr::non_null::NonNull" [mir_u8];
let phantom_u8_adt = mir_find_adt m "core::marker::PhantomData" [mir_u8];
let phantom_i64_adt = mir_find_adt m "core::marker::PhantomData" [mir_i64];
let capacity_adt = mir_find_adt m "core::num::niche_types::UsizeNoHighBit" [];
let constructor_name = mir_find_name m "polynomial_ring::{impl#1}::new" [mir_i64];
let padding_spec = do {
  a <- mir_fresh_var "a" (mir_array 8 mir_i64);
  data <- mir_alloc_raw_ptr_const_multi 8 mir_i64;
  mir_points_to_multi data (mir_term a);
  cap <- mir_fresh_var "capacity" mir_usize;
  mir_precond {{ (8 <= cap) && (cap <= 1152921504606846975) }};
  let phantom_i64 = mir_struct_value phantom_i64_adt [];
  let phantom_u8 = mir_struct_value phantom_u8_adt [];
  let nonnull = mir_struct_value nonnull_adt [mir_cast_raw_ptr data mir_u8];
  let unique = mir_struct_value unique_adt [nonnull, phantom_u8];
  let inner = mir_struct_value inner_adt [unique, mir_struct_value capacity_adt [mir_term cap],
                                         mir_struct_value typed_allocator_adt [phantom_i64]];
  let buffer = mir_struct_value raw_vec_adt [inner, mir_struct_value allocator [], phantom_i64];
  let input = mir_struct_value vec_adt [buffer, mir_term {{ 8:[64] }}];
  logical_length <- mir_fresh_var "logical_length" mir_usize;
  mir_precond {{ logical_length <= (8:[64]) }};
  let short_vec = mir_struct_value vec_adt [buffer, mir_term logical_length];
  polynomial <- mir_ref_of (mir_struct_value poly_adt [short_vec]);
  mir_execute_func [polynomial, mir_term {{ 16:[64] }}];
  output <- mir_vec_of "output" mir_i64 (mir_term {{
    [if i < logical_length then x else 0 | i <- ([0..7]:[8][64]) | x <- a] # (zero:[8][64]) }});
  mir_return output;
  mir_points_to_multi data (mir_term a);

};
checked <- timeout 60000 (mir_verify m "ntt_polynomial_boundary_proof::padded" [] true padding_spec z3);
print "Verified fixed-allocation padding for arbitrary logical input length";
