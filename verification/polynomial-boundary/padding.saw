enable_experimental;
m <- mir_load_module (get_opt 1);
include "vec-layout.saw";
let padding_spec count = do {
  let c = count;
  a <- mir_fresh_var "a" (mir_array c mir_i64);
  data <- mir_alloc_raw_ptr_const_multi c mir_i64;
  mir_points_to_multi data (mir_term a);
  cap <- mir_fresh_var "capacity" mir_usize;
  mir_precond {{ (`c <= cap) && (cap <= 1152921504606846975) }};
  let phantom_i64 = mir_struct_value phantom_i64_adt [];
  let phantom_u8 = mir_struct_value phantom_u8_adt [];
  let nonnull = mir_struct_value nonnull_adt [mir_cast_raw_ptr data mir_u8];
  let unique = mir_struct_value unique_adt [nonnull, phantom_u8];
  let inner = mir_struct_value inner_adt [unique, mir_struct_value capacity_adt [mir_term cap],
                                         mir_struct_value typed_allocator_adt [phantom_i64]];
  let buffer = mir_struct_value raw_vec_adt [inner, mir_struct_value allocator [], phantom_i64];
  let input = mir_struct_value vec_adt [buffer, mir_term {{ `c:[64] }}];
  polynomial <- mir_ref_of (mir_struct_value poly_adt [input]);
  mir_execute_func [polynomial, mir_term {{ 2*`d:[64] }}];
  output <- mir_vec_of "output" mir_i64 (mir_term {{
    a # (zero:[2*d-c][64]) }});
  mir_return output;
  mir_points_to_multi data (mir_term a);

};
let lengths = map eval_int (eval_list {{ [first..first+count-1] : [count][64] }});
for lengths (\length -> do {
  _ <- timeout 30000 (mir_verify m "ring_lwe::utils::ntt_padding::padded" [] false (padding_spec length) abc);
  print (str_concat "Verified padding input length " (show length));
  return ();
});
print "Verified complete padding batch";

print (str_concat "Verified padding degree " (show d));
