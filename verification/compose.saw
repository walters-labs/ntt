// Check the public APIs, including construction of their validated parameters
// and twiddle tables, reusing only the proved production kernel contracts.
let public_overrides = concat arithmetic_overrides [forward_kernel, inverse_kernel];
let public_proof = do {
  simplify (addsimp convolution_expansion (cryptol_ss ()));
  // Preserve the verified transform boundaries. Their canonical-output
  // contracts discharge the pointwise multiplication preconditions directly.
  w4_unint_z3 ["forward", "inverse", "normalizePoly", "value", "repr", "normalize"];
};
include "pointwise-result.saw";
include "pointwise-bounds.saw";
let forward_spec = do {
  a <- mir_fresh_var "a" (mir_array n mir_i64);
  mir_execute_func [mir_term a];
  mir_return (mir_term {{ forward (normalizePoly a) }});
};
forward_verified <- timeout 600000 (mir_verify m (entry "forward_")
  public_overrides false forward_spec public_proof);
print (str_concat "Verified forward NTT for all i64 inputs: " suffix);
let inverse_spec = do {
  a <- mir_fresh_var "a" (mir_array n mir_i64);
  mir_execute_func [mir_term a];
  mir_return (mir_term {{ inverse (normalizePoly a) }});
};
inverse_verified <- timeout 600000 (mir_verify m (entry "inverse_")
  public_overrides false inverse_spec public_proof);
print (str_concat "Verified inverse NTT for all i64 inputs: " suffix);
let multiply_spec = do {
  a <- mir_fresh_var "a" (mir_array n mir_i64);
  b <- mir_fresh_var "b" (mir_array n mir_i64);
  mir_execute_func [mir_term a, mir_term b];
  mir_return (mir_term {{ convolution (normalizePoly a) (normalizePoly b) }});
};
multiply_verified <- timeout 600000 (mir_verify m (entry "multiply_")
  public_overrides false multiply_spec multiply_proof);
print (str_concat "Verified cyclic multiplication for all i64 inputs: " suffix);
