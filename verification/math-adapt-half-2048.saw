// This adapter checks proposition equality. Its controller additionally
// requires the successful archived proof and all of that proof's source hashes.
import "Ntt1024.cry" as Old;
import "Ntt2048.cry";
let n = 2048;
let q = 12289;
include "lemmas.saw";
include "math-tactics.saw";
include "math-components.saw";
let old_n = eval_int {{ fromInteger Old::size : [64] }};
let old_root = eval_int {{ Old::parameters.root }};
let old_inverse_root = eval_int {{ Old::parameters.inverseRoot }};
let old_inverse_length = eval_int {{ Old::parameters.inverseLength }};
let old_statement = math_formula {{ \(a : [old_n]Coeff) (b : [old_n]Coeff) ->
  Old::idftN `old_inverse_root `old_inverse_length
    (Old::pointwise (Old::dftN `old_root a) (Old::dftN `old_root b)) == Old::convN a b }};
old_proposition <- native_proposition 2 old_n old_statement;
check_convertible old_proposition half_convolution_prop;
write_core (str_concat (get_env "NTT_MATH_OUTPUT") "/half.core") half_convolution_prop;
print "Matched exported half-size theorem to the verified 1024-point checkpoint";
